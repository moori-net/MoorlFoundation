<div class="cms-element-{{ element.type }}">
    {% if element.config.provider.value %}
        {% set currentUrl = app.getRequest().attributes.get('sw-sales-channel-absolute-base-url') ~ app.getRequest().attributes.get('resolved-uri') %}
        {% if activeRoute == 'frontend.moorl.magazine.article' %}
            {% set currentUrl = seoUrl(activeRoute, {magazineArticleId:page.magazineArticle.id}) %}
        {% endif %}
        <div class="sticky-top">
            <ul>
                {% if 'api' in element.config.provider.value %}
                    <li class="d-none"
                        data-moorl-share
                        data-moorl-share-options="{{ {url: currentUrl}|json_encode|escape('html_attr') }}">
                        <button
                                type="button"
                                title="{{ "moorl-share.api"|trans }}"
                                class="btn btn-share-api"
                        >
                            {% sw_icon 'share' style {pack: 'fas'} %}
                        </button>
                    </li>
                {% endif %}

                {% if 'email' in element.config.provider.value %}
                    <li>
                        <a
                                title="{{ "moorl-share.email"|trans }}"
                                class="btn btn-email"
                                href="mailto:?body={{ currentUrl|url_encode }}"
                        >
                            {% sw_icon 'envelope' style {pack: 'far'} %}
                        </a>
                    </li>
                {% endif %}

                {% if 'facebook' in element.config.provider.value %}
                    <li>
                        <a
                                title="{{ "moorl-share.facebook"|trans }}"
                                class="btn btn-facebook"
                                href="https://www.facebook.com/sharer/sharer.php?u={{ currentUrl }}"
                                target="_blank"
                                rel="noopener"
                        >
                            {% sw_icon 'facebook' style {pack: 'fab'} %}
                        </a>
                    </li>
                {% endif %}

                {% if 'x' in element.config.provider.value or 'twitter' in element.config.provider.value %}
                    <li>
                        <a
                                title="{{ "moorl-share.x-twitter"|trans }}"
                                class="btn btn-x-twitter"
                                href="https://x.com/intent/tweet?url={{ currentUrl }}"
                                target="_blank"
                                rel="noopener"
                        >
                            {% sw_icon 'x-twitter' style {pack: 'fab'} %}
                        </a>
                    </li>
                {% endif %}

                {% if 'whatsapp' in element.config.provider.value %}
                    <li>
                        <a
                                title="{{ "moorl-share.whatsapp"|trans }}"
                                class="btn btn-whatsapp"
                                href="https://api.whatsapp.com/send?text={{ currentUrl|url_encode }}"
                                target="_blank"
                                rel="noopener"
                        >
                            {% sw_icon 'whatsapp' style {pack: 'fab'} %}
                        </a>
                    </li>
                {% endif %}

                {% if 'pinterest' in element.config.provider.value %}
                    <li>
                        <a
                                title="{{ "moorl-share.pinterest"|trans }}"
                                class="btn btn-pinterest"
                                href="http://pinterest.com/pin/create/button/?url={{ currentUrl }}"
                                target="_blank"
                                rel="noopener"
                        >
                            {% sw_icon 'pinterest' style {pack: 'fab'} %}
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    {% endif %}
</div>
