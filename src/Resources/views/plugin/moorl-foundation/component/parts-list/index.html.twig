{% set options = {
    currencyIso: context.currency.isoCode
} %}

{% if items.count > 0 %}
    <div
            class="moorl-parts-list"
            data-moorl-parts-list
            data-moorl-parts-list-options='{{ options|json_encode|raw }}'
    >
        <ul class="moorl-parts-list-items">
            <li class="moorl-parts-list-item moorl-parts-list-item-header">
                <div class="order-product-cover"></div>
                <div class="order-quantity">{{ "moorl-foundation.field.quantity"|trans }}</div>
                <div class="order-product-content">{{ "moorl-foundation.field.product"|trans }}</div>
                <div class="order-price text-end">{{ "moorl-foundation.field.unitPrice"|trans }}</div>
            </li>

            {% for item in items %}
                {% sw_include '@MoorlFoundation/plugin/moorl-foundation/component/parts-list/product-item.html.twig' %}
            {% endfor %}
        </ul>
    </div>
{% elseif config('MoorlFoundation.config.cmsEmptyAlert') %}
    {% sw_include "@Storefront/storefront/utilities/alert.html.twig" with {
        type: "primary",
        content: options.emptyText ?: "moorl-foundation.search.notAvailable"|trans
    } %}
{% endif %}
